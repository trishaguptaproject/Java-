//Demonstrating Java interfaces: List, Set, and Map
//ListExample
import java.util.ArrayList;
import java.util.List;

public class ListExample {

    public static void main(String[] args) {

        System.out.println("----- List Interface -----");

        List<String> animals = new ArrayList<>();

        animals.add("Dog");
        animals.add("Cat");
        animals.add("Rabbit");
        animals.add("Dog"); // Duplicate allowed

        System.out.println("Initial List: " + animals);

        animals.add(1, "Horse");
        System.out.println("After adding Horse: " + animals);

        System.out.println("First Animal: " + animals.get(0));

        animals.set(2, "Tiger");
        System.out.println("After updating index 2: " + animals);

        animals.remove("Dog");
        System.out.println("After removing first Dog: " + animals);

        animals.remove(animals.size() - 1);
        System.out.println("After removing last element: " + animals);

        System.out.println("Index of Rabbit: " + animals.indexOf("Rabbit"));
        System.out.println("Contains Cat? " + animals.contains("Cat"));
        System.out.println("List Size: " + animals.size());

        animals.clear();
        System.out.println("List after clear(): " + animals);
    }
}

//SetExample
import java.util.HashSet;
import java.util.Iterator;
import java.util.Set;

public class SetExample {

    public static void main(String[] args) {

        System.out.println("----- Set Interface -----");

        Set<String> cities = new HashSet<>();

        cities.add("Mumbai");
        cities.add("Delhi");
        cities.add("Pune");
        cities.add("Mumbai"); // Duplicate ignored

        System.out.println("Initial Set: " + cities);

        cities.remove("Delhi");
        System.out.println("After removing Delhi: " + cities);

        System.out.println("Contains Pune? " + cities.contains("Pune"));
        System.out.println("Set Size: " + cities.size());
        System.out.println("Is Set Empty? " + cities.isEmpty());

        System.out.print("Set Elements: ");

        Iterator<String> itr = cities.iterator();

        while (itr.hasNext()) {
            System.out.print(itr.next() + " ");
        }

        System.out.println();

        Set<String> newCities = new HashSet<>();
        newCities.add("Nagpur");
        newCities.add("Pune");

        cities.addAll(newCities);

        System.out.println("After addAll(): " + cities);
    }
}
//MapExample
import java.util.HashMap;
import java.util.Map;

public class MapExample {

    public static void main(String[] args) {

        System.out.println("----- Map Interface -----");

        Map<String, Integer> marks = new HashMap<>();

        marks.put("Trisha", 89);
        marks.put("Anchal", 95);
        marks.put("Preeti", 82);
        marks.put("Namita", 91);

        System.out.println("Initial Map: " + marks);

        System.out.println("Marks of Anchal: " + marks.get("Anchal"));

        marks.remove("Preeti");
        System.out.println("After removing Preeti: " + marks);

        System.out.println("Contains Key Trisha? " + marks.containsKey("Trisha"));
        System.out.println("Contains Value 91? " + marks.containsValue(91));

        System.out.println("Keys: " + marks.keySet());
        System.out.println("Values: " + marks.values());
        System.out.println("Entries: " + marks.entrySet());

        System.out.println("Map Size: " + marks.size());

        marks.clear();
        System.out.println("Map after clear(): " + marks);
    }
}
