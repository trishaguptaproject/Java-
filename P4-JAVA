//List Interface
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Scanner;

public class ListDemo {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        List<Double> marksList = new ArrayList<>();

        System.out.println("Enter 5 decimal numbers:");

        for (int i = 1; i <= 5; i++) {
            System.out.print("Enter number " + i + ": ");
            marksList.add(sc.nextDouble());
        }

        System.out.println("\nList Elements: " + marksList);

        double total = 0;

        for (double value : marksList) {
            total += value;
        }

        System.out.println("Total = " + total);
        System.out.println("Average = " + (total / marksList.size()));

        System.out.println("Minimum = " + Collections.min(marksList));
        System.out.println("Maximum = " + Collections.max(marksList));

        System.out.print("Enter a number to remove: ");
        double remove = sc.nextDouble();

        if (marksList.remove(remove)) {
            System.out.println("Updated List: " + marksList);
        } else {
            System.out.println("Number not found.");
        }

        sc.close();
    }
}
//Set Interface
import java.util.HashSet;
import java.util.Set;
import java.util.Scanner;

public class SetDemo {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Set<Integer> numberSet = new HashSet<>();

        System.out.println("Enter 5 integers:");

        for (int i = 1; i <= 5; i++) {
            System.out.print("Enter integer " + i + ": ");
            numberSet.add(sc.nextInt());
        }

        System.out.println("\nSet Elements: " + numberSet);

        int sum = 0;

        for (int num : numberSet) {
            sum += num;
        }

        System.out.println("Sum = " + sum);

        Set<Integer> squareSet = new HashSet<>();

        for (int num : numberSet) {
            squareSet.add(num * num);
        }

        System.out.println("Square of Elements: " + squareSet);

        System.out.print("Enter an integer to remove: ");
        int remove = sc.nextInt();

        if (numberSet.remove(remove)) {
            System.out.println("Updated Set: " + numberSet);
        } else {
            System.out.println("Element not found.");
        }

        sc.close();
    }
}

//Map Interface
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class MapDemo {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Map<String, Double> studentMarks = new HashMap<>();

        System.out.println("Enter marks of 3 students:");

        for (int i = 1; i <= 3; i++) {

            System.out.print("Student Name " + i + ": ");
            String name = sc.next();

            System.out.print("Marks of " + name + ": ");
            double marks = sc.nextDouble();

            studentMarks.put(name, marks);
        }

        System.out.println("\nStudent Marks: " + studentMarks);

        double total = 0;

        for (double marks : studentMarks.values()) {
            total += marks;
        }

        System.out.println("Total Marks = " + total);

        System.out.print("Enter student name to update marks: ");
        String student = sc.next();

        if (studentMarks.containsKey(student)) {

            System.out.print("Enter new marks: ");
            double newMarks = sc.nextDouble();

            studentMarks.put(student, newMarks);

            System.out.println("Updated Map: " + studentMarks);

        } else {
            System.out.println("Student not found.");
        }

        total = 0;

        for (double marks : studentMarks.values()) {
            total += marks;
        }

        System.out.println("New Total Marks = " + total);

        System.out.print("Enter student name to remove: ");
        String removeStudent = sc.next();

        if (studentMarks.remove(removeStudent) != null) {
            System.out.println("Updated Map: " + studentMarks);
        } else {
            System.out.println("Student not found.");
        }

        sc.close();
    }
}
