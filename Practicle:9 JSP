//getCookie.jsp
```jsp
<%@ page import="java.net.URLDecoder" %>

<%
    String username = null;

    Cookie[] cookies = request.getCookies();

    if (cookies != null) {

        for (Cookie cookie : cookies) {

            if ("username".equals(cookie.getName())) {

                username = URLDecoder.decode(
                    cookie.getValue(),
                    "UTF-8"
                );

                break;
            }
        }
    }
%>

